# UniFi Network Controller / OS connection
UNIFI_HOST=https://192.168.1.1
UNIFI_API_KEY=replace-with-a-generated-api-key
UNIFI_SITE=default
# Most UniFi controllers use a self-signed certificate; set to true if yours
# has a trusted one.
UNIFI_VERIFY_SSL=false

# Polling
POLL_INTERVAL_SECONDS=30

# Security event ingestion
SYSLOG_LISTEN_HOST=0.0.0.0
SYSLOG_LISTEN_PORT=5514
# Required to use the /api/events/ingest webhook from outside localhost.
INGEST_WEBHOOK_TOKEN=replace-with-a-random-shared-secret

# Flask
FLASK_SECRET_KEY=replace-with-a-random-secret
FLASK_DEBUG=false
